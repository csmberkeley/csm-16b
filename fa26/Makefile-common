# Shared build rules for every worksheet folder in this semester.
#
# A worksheet folder (e.g. fa26/04/) only needs two files:
#   Makefile   -- one line:  include ../Makefile-common
#   body.tex   -- picks the questions
# Create one with `make new N=04` from the semester folder.
#
# Inside a worksheet folder:
#   make          build ws/sol/meta PDFs and copy them into build/
#   make ws       worksheet only (also: make sol, make meta, make test)
#   make clean    delete generated files
#
# Output names come from the folder name, so 04/ always gives ws04.pdf etc.
# (the ws04.tex/sol04.tex/meta04.tex stubs are only for editors' "build" buttons).

N := $(notdir $(CURDIR))

TEX      := pdflatex
TEXFLAGS := -interaction=nonstopmode -halt-on-error -file-line-error

WS   := ws$(N)
SOL  := sol$(N)
META := meta$(N)

images := $(patsubst %.svg,%.png,$(wildcard figures/*.svg))

# $(call latex,<jobname>,<../X.tex>)
# Runs pdflatex twice (so references resolve). On failure, prints the first
# error with its file and line number instead of pdflatex's wall of output.
define latex
@echo "==> building $(1).pdf"
@export max_print_line=1000; \
  $(TEX) $(TEXFLAGS) -jobname=$(1) $(2) > /dev/null 2>&1 \
  && $(TEX) $(TEXFLAGS) -jobname=$(1) $(2) > /dev/null 2>&1 \
  || { echo ""; \
       echo "*** LaTeX error while building $(1).pdf"; \
       grep -m1 -E ':[0-9]+: |^! ' $(1).log | sed 's/^/    error: /'; \
       grep -m1 -E '^l[.][0-9]+ ' $(1).log | sed 's/^l[.]/    at line /'; \
       echo "    (full log: $(N)/$(1).log)"; \
       exit 1; }
-@rm -f $(1).log $(1).out $(1).annotations
endef

.PHONY: all ws sol meta test check clean cleanpdfs

all: ws sol meta
	@mkdir -p build
	@cp $(WS).pdf $(SOL).pdf $(META).pdf build/
	@echo "done: build/$(WS).pdf build/$(SOL).pdf build/$(META).pdf"

ws: check $(images)
	$(call latex,$(WS),../ws.tex)

sol: check $(images)
	$(call latex,$(SOL),../sol.tex)

meta: check $(images)
	$(call latex,$(META),../meta.tex)

test: check $(images)
	$(call latex,test,../test.tex)

check:
	@test -f body.tex || { \
	  echo "*** No body.tex in $(CURDIR)"; \
	  echo "    Create a worksheet with:  cd .. && make new N=$(N)"; \
	  exit 1; }

%.png: %.svg
	@command -v inkscape > /dev/null \
	  && inkscape --export-type=png --export-dpi=400 --export-filename=$@ $< \
	  || echo "inkscape not found, skipping $<"

clean:
	-@rm -f *.aux *.log *.out *.annotations *.toc *.fls *.fdb_latexmk *.synctex.gz *.dvi
	-@rm -rf build $(WS).pdf $(SOL).pdf $(META).pdf test.pdf

cleanpdfs:
	-@rm -rf build $(WS).pdf $(SOL).pdf $(META).pdf test.pdf
